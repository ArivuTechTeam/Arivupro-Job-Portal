# ── Local Development ─────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-super-secret-key-change-this
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Production (Railway) ──────────────────────────────────────────────────────
# DJANGO_SECRET_KEY=long-random-production-key
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=your-app.railway.app,your-custom-domain.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite is used automatically when DATABASE_URL is not set.
# For production, paste the Supabase "Transaction pooler" connection string:
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── AI Configuration ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
OPENAI_API_KEY=sk-your-openai-api-key
AI_MODEL=anthropic/claude-sonnet-4-5

# ── Supabase Storage (for PDF answer scripts in production) ───────────────────
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJxxx
# USE_SUPABASE_STORAGE=True
# SUPABASE_STORAGE_BUCKET=arivupro-media
# Get these from: Supabase Dashboard → Project Settings → Storage → S3 Connection
# SUPABASE_S3_ACCESS_KEY=xxxx
# SUPABASE_S3_SECRET_KEY=xxxx

# ── Admin registration secret ─────────────────────────────────────────────────
ADMIN_REGISTRATION_CODE=ARIVUPRO-ADMIN-2024

# ── Email (Gmail SMTP, optional — for OTP) ────────────────────────────────────
# EMAIL_HOST_USER=tech@arivupro.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password

# ── Firebase / Firestore (optional) ──────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_PROJECT_ID=arivupro-examapp
